# MongoDB: lokal yoki Atlas (mongodb+srv://user:parol@cluster.mongodb.net)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=shirin
# Frontenddagi BACKEND_SECRET bilan bir xil bo'lishi shart
API_SHARED_SECRET=uzun-tasodifiy-qiymat
PORT=8787
# Serverda 0.0.0.0, lokalda 127.0.0.1
HOST=127.0.0.1
# Birinchi superadmin: login email bo'lishi shart emas (superadmin yo'q bo'lganda server ishga tushganda yaratiladi). Parol kamida 8 belgi.
OWNER_LOGIN=superadmin
OWNER_PASSWORD=o-zingizning-kuchli-parolingiz
OWNER_NAME=Superadmin
